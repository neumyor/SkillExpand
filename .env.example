# Copy to .env and replace placeholders. The real .env is ignored by Git.
export EXPE_LLM_BASE_URL="https://llm.example.invalid/v1"
export EXPE_LLM_MODEL="your-model-id"
export OPENAI_API_KEY="replace-with-your-api-key"

# ALFWorld only: use an interpreter with alfworld and textworld installed.
export ALFWORLD_PYTHON="/absolute/path/to/alfworld-venv/bin/python"
export ALFWORLD_DATA="/absolute/path/to/alfworld-data"
export ALFWORLD_CONFIG="/absolute/path/to/textworld.yaml"
export ALFWORLD_BENCH_SRC="/absolute/path/to/alfworld-benchmark/src"

# Only needed by scripts/run_campaign.py when dependencies use an overlay.
export EXPE_CAMPAIGN_OVERLAY="/absolute/path/to/dependency-overlay"
